# Copy to .env (gitignored) and adjust. Relative paths are resolved from the repository root.

# Google OAuth *Web application* client for the Streamlit app (not the CLI's desktop client)
GOOGLE_WEB_CREDENTIALS=config/credentials_web.json
# Must be listed as an authorized redirect URI of that client
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501

# Claude, used by the cancellation guide and the legacy-policy crawler ("Look up" in the app), runs
# through the Claude Code CLI with its own login (run `claude` once and log in): no key needed here.
# Optional model for those calls (default: sonnet)
# CLAUDE_MODEL=sonnet
# Optional: use another Claude account than your usual login. Pick a folder (absolute path), log in once
# with  CLAUDE_CONFIG_DIR=<folder> claude auth login  and set the same folder here.
# CLAUDE_CONFIG_DIR=/Users/<you>/.claude-demo

# Swisscom-hosted Apertus model, used only by the subscription finder's optional LLM step.
# The finder also reads subscription_finder/.env.
# If your key lives in subscription_finder/.env, delete these two lines: an empty value here hides it.
SWISSCOM_API_KEY=
# OpenAI-compatible endpoint of the Swisscom-hosted Apertus model (from your hackathon access page)
SWISSCOM_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1

# Guided onboarding for the pitch recording (docs/design/onboarding-demo.md): 1 = on, 0 = normal app
DLV_ONBOARDING=0
